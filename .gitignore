# Godot 4+ specific ignores
.godot/
.import/
export.cfg
# export_presets.cfg is intentionally NOT ignored: it holds no secrets for the
# Web preset and needs to be shared/committed so the export config persists
# across sessions/machines.

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Build output (not source; regenerated via Godot export)
/builds/

# System/tool-specific ignores
.DS_Store
Thumbs.db
